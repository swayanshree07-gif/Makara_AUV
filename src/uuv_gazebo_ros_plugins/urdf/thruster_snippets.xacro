<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- THRUSTER MODULE (HARMONIC) -->
  <!-- ============================= -->

  <xacro:macro name="generic_thruster_macro"
    params="namespace thruster_id *origin mesh_filename">

    <!-- Joint -->
    <joint name="${namespace}/thruster_${thruster_id}_joint" type="continuous">
      <xacro:insert_block name="origin"/>
      <axis xyz="1 0 0"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/thruster_${thruster_id}"/>
    </joint>

    <!-- Link -->
    <link name="${namespace}/thruster_${thruster_id}">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_filename}" scale="1 1 1"/>
        </geometry>
      </visual>

      <collision>
        <geometry>
          <cylinder length="0.001" radius="0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- ============================= -->
    <!-- GAZEBO HARMONIC PLUGIN -->
    <!-- ============================= -->

    <gazebo reference="${namespace}/thruster_${thruster_id}">
      <plugin
        filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">

        <!-- Joint to control -->
        <joint_name>${namespace}/thruster_${thruster_id}_joint</joint_name>

        <!-- You will publish velocity/force -->
        <topic>/thruster_${thruster_id}/cmd</topic>

      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
