<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- ACCELERATION TEST (REMOVED) -->
  <!-- ============================= -->

  <!--
    libuuv_accelerations_test_plugin.so is NOT available in Gazebo Harmonic.

    To get acceleration data:
    - Use /world/.../link/... topics from Gazebo
    - Or write a custom gz::sim::System plugin
  -->

  <xacro:macro name="acceleration_test_macro" params="link_name">
    <!-- No direct equivalent -->
  </xacro:macro>


  <!-- ============================= -->
  <!-- JOINT STATE PUBLISHER -->
  <!-- ============================= -->

  <xacro:macro name="default_joint_state_publisher" params="namespace update_rate">

    <gazebo>
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">

        <topic>/world/joint_states</topic>
        <update_rate>${update_rate}</update_rate>

      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
