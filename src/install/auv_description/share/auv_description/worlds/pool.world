        <parent>base_link</parent><child>thruster7</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="thruster7">
        <pose relative_to="thruster7_joint">0 0 0 0 0 0</pose>
        <inertial><pose>0.0175 0 0 0 0 0</pose><mass>0.1</mass><inertia><ixx>0.000125</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.27e-05</iyy><iyz>0</iyz><izz>7.27e-05</izz></inertia></inertial>
        <visual name="thruster7_visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><scale>1 1 1</scale><uri>model://bluerov2_description/meshes/bluerov2_propcw.dae</uri></mesh></geometry></visual>
      </link>

      <joint name="thruster8_joint" type="revolute">
        <pose relative_to="base_link">-0.12 -0.218 -0.02 0 -1.5707963268 0</pose>
        <parent>base_link</parent><child>thruster8</child>
        <axis><xyz>-1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="thruster8">
        <pose relative_to="thruster8_joint">0 0 0 0 0 0</pose>
        <inertial><pose>0.0175 0 0 0 0 0</pose><mass>0.1</mass><inertia><ixx>0.000125</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.27e-05</iyy><iyz>0</iyz><izz>7.27e-05</izz></inertia></inertial>
        <visual name="thruster8_visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><scale>1 1 1</scale><uri>model://bluerov2_description/meshes/bluerov2_propccw.dae</uri></mesh></geometry></visual>
      </link>

      <plugin name="ignition::gazebo::systems::Hydrodynamics" filename="libignition-gazebo-hydrodynamics-system.so">
        <link_name>base_link</link_name>
        <xDotU>-5.5</xDotU><yDotV>-12.7</yDotV><zDotW>-14.57</zDotW>
        <kDotP>-0.12</kDotP><mDotQ>-0.12</mDotQ><nDotR>-0.12</nDotR>
        <xU>-25.15</xU><yV>-7.364</yV><zW>-17.955</zW>
        <kP>-10.888</kP><mQ>-20.761</mQ><nR>-3.744</nR>
        <xUabsU>-17.77</xUabsU><yVabsV>-125.9</yVabsV><zWabsW>-72.36</zWabsW>
        <kPabsP>-0.1246</kPabsP><mQabsQ>-0.1246</mQabsQ><nRabsR>-0.1857</nRabsR>
      </plugin>

      <plugin name="ignition::gazebo::systems::Thruster" filename="libignition-gazebo-thruster-system.so">
        <joint_name>thruster1_joint</joint_name>
        <thrust_coefficient>0.02</thrust_coefficient><fluid_density>1000</fluid_density>
        <propeller_diameter>0.1</propeller_diameter><velocity_control>false</velocity_control>
      </plugin>
      <plugin name="ignition::gazebo::systems::Thruster" filename="libignition-gazebo-thruster-system.so">
