        <visual name="thruster5_visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><scale>1 1 1</scale><uri>model://bluerov2_description/meshes/bluerov2_propcw.dae</uri></mesh></geometry></visual>
      </link>

      <joint name="thruster6_joint" type="revolute">
        <pose relative_to="base_link">0.12 -0.218 -0.02 0 -1.5707963268 0</pose>
        <parent>base_link</parent><child>thruster6</child>
        <axis><xyz>-1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <link name="thruster6">
        <pose relative_to="thruster6_joint">0 0 0 0 0 0</pose>
        <inertial><pose>0.0175 0 0 0 0 0</pose><mass>0.1</mass><inertia><ixx>0.000125</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.27e-05</iyy><iyz>0</iyz><izz>7.27e-05</izz></inertia></inertial>
