<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ardupilot_attitude_control</name>
  <version>0.0.1</version>
  <description>Implementation of ArduPilot Attitude Control logic for ROS 2.</description>
  <maintainer email="yamin@todo.todo">yamin</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>hammerhead_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>